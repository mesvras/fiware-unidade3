# Opções do Orion-LD. Cada variável ORIONLD_* corresponde a uma opção de linha de comando (orionld -U).

# Servidor do MongoDB (-dbhost).
ORIONLD_MONGO_HOST=mongo

# Usa somente o driver mongoc (-mongocOnly).
ORIONLD_MONGOCONLY=TRUE

# Uma thread por conexão HTTP (-reqPoolSize 0).
# O pool padrão da versão 1.12 corrompe requisições concorrentes (issue #1943). Consulte docker/README.md.
ORIONLD_TRQ_POOL_SIZE=0
